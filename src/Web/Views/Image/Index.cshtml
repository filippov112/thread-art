@model ImageDto
@{
    ViewData["Title"] = "Загрузка изображения";
}

<body>
    <div class="container">
        <h2>Загрузите изображение</h2>
        <form asp-action="UploadImage" method="post" enctype="multipart/form-data">
            <div class="form-group">
                <label asp-for="ImageFile">Изображение:</label>
                <input asp-for="ImageFile" type="file" />
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="SmallSize.Width">Ширина расчетной матрицы:</label>
                    <input asp-for="SmallSize.Width" type="number" />
                </div>
                <div class="form-group">
                    <label asp-for="SmallSize.Height">Высота расчетной матрицы:</label>
                    <input asp-for="SmallSize.Height" type="number" />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="LargeSize.Width">Ширина матрицы отрисовки:</label>
                    <input asp-for="LargeSize.Width" type="number" />
                </div>
                <div class="form-group">
                    <label asp-for="LargeSize.Height">Высота матрицы отрисовки:</label>
                    <input asp-for="LargeSize.Height" type="number" />
                </div>
            </div>

            <div class="form-group">
                <label asp-for="CountPoints">Число точек:</label>
                <input asp-for="CountPoints" type="number" />
            </div>
            <div class="form-group">
                <label asp-for="CountSteps">Количество шагов:</label>
                <input asp-for="CountSteps" type="number" />
            </div>
            <div class="form-group">
                <label asp-for="IsEllipse">Тип матрицы (эллипс):</label>
                <input asp-for="IsEllipse" type="checkbox" />
            </div>
            <div class="form-group">
                <label asp-for="ContrastLine">Толщина нити:</label>
                <input asp-for="ContrastLine" type="number" />
            </div>
            <div class="form-group" id="progressBar">
                <div id="progress"></div>
            </div>
            <button type="submit">Загрузить</button>
        </form>   
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/5.0.11/signalr.min.js"></script>
    <script src="~/js/signalr.js"></script>
</body>



